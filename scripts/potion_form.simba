type
  TPotionMakerForm = record
    Form: TScriptForm;
    MaxRuntimeEdit: TLazEdit;
    MaxActionsEdit: TLazEdit;
    PotionList: TLazCheckListBox;
    RecipeIds: TStringArray;
  end;

procedure TPotionMakerForm.CreateSettingsTab();
var
  tab: TLazTabSheet;
  parser: TJSONParser;
  saved: TJSONItem;
  path, id: String;
  i, j: Integer;
begin
  tab := Self.Form.CreateTab('Settings');

  Self.MaxRuntimeEdit := TLazEdit.CreateEx(tab, 'Max runtime', '', 50, 20, 100, 20);
  if Self.Form.ConfigData.Assert('max_runtime', EJSONType.INT) then
    Self.MaxRuntimeEdit.Text := ToStr(Self.Form.ConfigData.Item['max_runtime'].AsInt)
  else
    Self.MaxRuntimeEdit.Text := '0';

  Self.MaxActionsEdit := TLazEdit.CreateEx(tab, 'Max actions', '', 50, 60, 100, 20);
  if Self.Form.ConfigData.Assert('max_actions', EJSONType.INT) then
    Self.MaxActionsEdit.Text := ToStr(Self.Form.ConfigData.Item['max_actions'].AsInt)
  else
    Self.MaxActionsEdit.Text := '0';

  path := PathExtractDir(SCRIPT_FILE) + PATH_SEP + 'potion_recipes.json';
  parser := new TJSONParser();
  parser.Load(path);

  Self.RecipeIds := [];
  Self.PotionList := TLazCheckListBox.CreateEx(tab, 'Potions to make', '', 50, 100, 220, 280);
  Self.PotionList.Items.BeginUpdate();
  for i := 0 to parser.Count - 1 do
  begin
    id := parser.Item[i].Item['id'].AsString;
    Self.RecipeIds += id;
    Self.PotionList.Items.Add(id.Replace('_', ' '));
  end;
  Self.PotionList.Items.EndUpdate();

  if Self.Form.ConfigData.Assert('potions', EJSONType.ARR) then
  begin
    saved := Self.Form.ConfigData.Item['potions'];
    for i := 0 to High(Self.RecipeIds) do
      for j := 0 to saved.Count - 1 do
        if saved.Item[j].AsString = Self.RecipeIds[i] then
          Self.PotionList.Checked[i] := True;
  end;
end;

procedure TPotionMakerForm.SaveSettings(Config: TConfigJSON);
var
  maxRuntime, maxActions, i: Integer;
  potions: TJSONArray;
begin
  maxRuntime := StrToInt(Self.MaxRuntimeEdit.Text, 0);
  maxActions := StrToInt(Self.MaxActionsEdit.Text, 0);

  if Config.Data.Assert('max_runtime', EJSONType.INT) then
    Config.Data.Item['max_runtime'].AsInt := maxRuntime
  else
    Config.Data.AddInt('max_runtime', maxRuntime);

  if Config.Data.Assert('max_actions', EJSONType.INT) then
    Config.Data.Item['max_actions'].AsInt := maxActions
  else
    Config.Data.AddInt('max_actions', maxActions);

  if Config.Data.Has('potions') then
    Config.Data.Delete(Config.Data.Item['potions']);

  potions := new TJSONArray();
  for i := 0 to High(Self.RecipeIds) do
    if Self.PotionList.Checked[i] then
      potions.AddString('potion', Self.RecipeIds[i]);
  Config.Data.AddArray('potions', potions);

  Config.Save();
end;

function TPotionMakerForm.GetSelectedPotions(): TStringArray;
var
  i: Integer;
begin
  Result := [];
  for i := 0 to High(Self.RecipeIds) do
    if Self.PotionList.Checked[i] then
      Result += Self.RecipeIds[i];
end;

procedure TPotionMakerForm.Setup(caption: String = 'Potion Maker'; configData: TJSONItem = nil);
begin
  Self.Form.Setup(caption, configData);
  Self.CreateSettingsTab();
  Self.Form.CreateAntibanTab();
end;

procedure TPotionMakerForm.Run();
begin
  Self.Form.Run();
end;
